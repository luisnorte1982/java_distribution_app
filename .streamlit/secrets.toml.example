# Streamlit Cloud Secrets — copiez ce bloc dans:
# Streamlit Cloud > votre app > Settings > Secrets
# Pour un test local, créez .streamlit/secrets.toml avec ce même format.

BC_TENANT_ID = "ad140881-5aae-4f5d-8941-89111ecfcdcc"
BC_CLIENT_ID = "votre-client-id-azure-ad"
BC_CLIENT_SECRET = "votre-client-secret-azure-ad"
BC_SCOPE = "https://api.businesscentral.dynamics.com/.default"

# Configuration Business Central
BC_ENVIRONMENT = "Production"
BC_COMPANY = "JAVA Distribution"
# Optionnel si vous devez interroger une seconde société:
# BC_COMPANY_BE = "JAVA BE"

# Optionnel: chemin d'un fichier local (mode démo)
CONSOLIDATED_FILE = "data/CONSOLIDE1.xlsx"
